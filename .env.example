# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Optional: full path to tesseract binary if it is not on PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: folder with *.traineddata if Czech data is not in the default tessdata
# (e.g. no admin rights on Windows). Example: C:\Users\<you>\AppData\Local\tessdata
TESSDATA_PREFIX=
