# Copy to .env and fill in. Never commit .env.
# All other settings live in config/fides.yaml (docs/settings.md); any of them can be overridden here
# with the FIDES_ prefix, e.g. FIDES_OFFLINE=true or FIDES_OCR__DPI=400.
ANTHROPIC_API_KEY=

# Optional: another model than llm.model in config/fides.yaml
LLM_MODEL=

# Optional: no LLM call at all (the AI report step is skipped); works without an API key
FIDES_OFFLINE=false

# Optional: full path to tesseract binary if it is not on PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: folder with *.traineddata if Czech data is not in the default tessdata
# (e.g. no admin rights on Windows). Example: C:\Users\<you>\AppData\Local\tessdata
TESSDATA_PREFIX=

# Vision baseline (CIPW-8): provider "anthropic" (default) or "mistral" (what Cofidis uses)
LLM_PROVIDER=anthropic
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-3.5
