# Copy to .env and fill in. Never commit .env.
# All other settings live in config/fides.yaml (docs/settings.md); any of them can be overridden here
# with the FIDES_ prefix, e.g. FIDES_OFFLINE=true or FIDES_OCR__DPI=400.
# The AI report's language model: Mistral (docs/llm.md). Empty: the assessment is the rule-based one.
MISTRAL_API_KEY=

# Optional: another model than llm.model in config/fides.yaml (default mistral-medium-3.5)
MISTRAL_MODEL=

# Optional: a Mistral model on a server of one's own (chat completions API), e.g. http://llm.internal:8000/v1
# FIDES_LLM__URL=

# Optional: token prices in USD per million tokens, for the cost in the result
# LLM_PRICE_IN_PER_MTOK=
# LLM_PRICE_OUT_PER_MTOK=

# Optional: no call to the internet at all (no LLM, no ARES); works without an API key
FIDES_OFFLINE=false

# Optional: full path to tesseract binary if it is not on PATH
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: folder with *.traineddata if Czech data is not in the default tessdata
# (e.g. no admin rights on Windows). Example: C:\Users\<you>\AppData\Local\tessdata
TESSDATA_PREFIX=

# Vision baseline experiment (CIPW-8, docs/vision_baseline.md): provider "anthropic" (default), "mistral" (uses
# MISTRAL_API_KEY and MISTRAL_MODEL above) or "gemini" (free tier)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
