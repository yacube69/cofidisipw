# Never ship secrets or local environments in the image
.env
.env.*
!.env.example
.venv/
venv/
.git/
.github/

# Caches and outputs
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
outputs/
output/
reports/

# Source statements stay outside the image (mount data/ as a volume)
data/raw/*.pdf

# The web app is built inside the image (first stage)
web/node_modules/
web/dist/
